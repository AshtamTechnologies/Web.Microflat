# MicroFlat ERP Environment Configuration Example
# Copy this file to .env.local to configure your local development environment.
# .env.local is ignored by git and will never be committed.

# Backend API Base URL (leave empty or set to real backend endpoint)
VITE_API_BASE_URL=https://api.microflat.ashtamtechnologies.com

# Mock API Toggle: set to true to run offline against mock data, false to use real backend API
VITE_USE_MOCK_API=false
